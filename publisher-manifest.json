}\n    .step-3{margin-left:68px}\n    .step .idx{font-size:34px;font-weight:800;line-height:1;color:rgba(107,31,42,.22);letter-spacing:-0.02em}\n    .step .plan-name{margin:0;font-size:1.24rem;font-weight:800;color:var(--wine-deep);letter-spacing:0.05em}\n    .step .price{margin:6px 0 0;font-size:1.1rem;font-weight:700;color:var(--wine)}\n    .step .annual{margin:4px 0 0;font-size:13px;color:var(--ink-soft)}\n    .step ul{margin:0;padding:0;list-style:none;font-size:14.5px;color:var(--ink)}\n    .step ul li{padding:5px 0 5px 18px;position:relative;border-bottom:1px dotted rgba(201,184,168,.75)}\n    .step ul li:last-child{border-bottom:0}\n    .step ul li::before{content:\"\";position:absolute;left:0;top:14px;width:7px;height:7px;background:var(--amber)}\n    .step.featured{border:1px solid var(--wine);background:#fffaf0;box-shadow:8px 8px 0 rgba(107,31,42,.08)}\n    .step.featured .idx{color:rgba(107,31,42,.35)}\n    .badge{display:inline-block;margin-bottom:8px;font-size:11px;letter-spacing:0.22em;color:#fff6e8;background:var(--wine);padding:2px 8px;border-radius:2px}\n\n    /* ---------- 双列信息块 ---------- */\n    .duo{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}\n    .ticket{background:var(--ivory-2);border:1px dashed var(--line);border-radius:2px;padding:22px 24px}\n    .ticket h3{margin:0 0 14px;font-size:1.06rem;letter-spacing:0.06em;color:var(--wine-deep)}\n    .ticket ol{margin:0;padding-left:1.2em;font-size:14.5px}\n    .ticket ol li{padding:6px 0;border-bottom:1px dotted rgba(201,184,168,.7)}\n    .ticket ol li:last-child{border-bottom:0}\n    .ticket ul{margin:0;padding:0;list-style:none;font-size:14.5px}\n    .ticket ul li{padding:7px 0;border-bottom:1px dotted rgba(201,184,168,.7);display:flex;justify-content:space-between;gap:14px}\n    .ticket ul li:last-child{border-bottom:0}\n    .ticket ul b{color:var(--wine);font-weight:700;white-space:nowrap}\n    .ticket p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n    .ticket p + p{margin-top:10px}\n\n    /* ---------- 客户端 ---------- */\n    .clients{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n    .client{background:var(--ivory-2);border:1px dashed var(--line);border-radius:2px;padding:20px}\n    .client h3{margin:0 0 8px;font-size:1rem;letter-spacing:0.06em;color:var(--wine-deep)}\n    .client p{margin:0 0 10px;font-size:14px;color:var(--ink-soft)}\n    .client .state{font-size:12px;letter-spacing:0.12em;color:var(--wine);border-top:1px dotted var(--line);padding-top:8px;display:block}\n\n    /* ---------- FAQ 按主题分组 ---------- */\n    .faq-groups{display:flex;flex-direction:column;gap:26px}\n    .faq-group h3{margin:0 0 12px;font-size:13px;letter-spacing:0.24em;color:var(--wine-soft);border-bottom:1px solid var(--line);padding-bottom:8px}\n    .qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}\n    .qa{background:var(--ivory-2);border:1px dashed var(--line);border-radius:2px;padding:18px 20px}\n    .qa h4{margin:0 0 8px;font-size:15.5px;color:var(--wine-deep);letter-spacing:0.02em;line-height:1.5}\n    .qa p{margin:0;font-size:14px;color:var(--ink-soft)}\n\n    /* ---------- 末尾跳转与页脚 ---------- */\n    .tail{margin-top:44px;border-top:1px solid var(--line);padding:26px 0 40px}\n    .tail .jumps{display:flex;gap:22px;flex-wrap:wrap;font-size:14px;margin-bottom:18px}\n    .tail .jumps a{border-bottom:1px dotted rgba(107,31,42,.5)}\n    .tail .meta{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-soft);letter-spacing:0.08em}\n\n    @media (max-width:860px){\n      .c-span-5,.c-span-4,.c-span-3,.c-span-7,.c-span-6{grid-column:span 12}\n      .step{grid-template-columns:44px minmax(0,1fr);gap:14px}\n      .step ul{grid-column:1 / -1}\n      .step-2{margin-left:14px}\n      .step-3{margin-left:28px}\n      .duo{grid-template-columns:1fr}\n      .clients{grid-template-columns:1fr}\n      .qa-grid{grid-template-columns:1fr}\n    }\n    @media (max-width:520px){\n      .step-2,.step-3{margin-left:0}\n      .step{padding:18px}\n      .step .idx{font-size:26px}\n    }\n  </style><div class=\"topline\">\n  <div class=\"wrap\">\n    <span class=\"mark\">猪云</span>\n    <nav class=\"jumps\" aria-label=\"页内跳转\">\n      <a href=\"#plans\">价格与权益</a>\n      <a href=\"#guide\">使用步骤</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <section class=\"hero\" id=\"top\">\n    <div class=\"wrap\">\n      <div class=\"hero-head\">\n        <h1>猪云</h1>\n        <p class=\"tagline\">把三档订阅摊开摆在桌面上：价格、流量、设备数量、支持方式，逐行对照，看完再决定。</p>\n      </div>\n\n      <div class=\"board\">\n        <div class=\"cell c-span-5 c-wine\">\n          <span class=\"label\">订阅档位</span>\n          <span class=\"value\">3 档</span>\n          <p class=\"note\">基础版、旗舰版、团队版，按月或按年两种付费周期。</p>\n        </div>\n\n        <div class=\"cell c-span-4\">\n          <span class=\"label\">月付起价</span>\n          <span class=\"value\">¥15</span>\n          <p class=\"note\">基础版月付价格，年付为 ¥150。</p>\n        </div>\n\n        <div class=\"cell c-span-3\">\n          <span class=\"label\">年付折扣口径</span>\n          <span class=\"value\">10 个月</span>\n          <p class=\"note\">三档年付均按月付价的十个月计。</p>\n        </div>\n\n        <div class=\"cell c-span-4\">\n          <span class=\"label\">设备数上限</span>\n          <span class=\"value\">3 / 5 / 20</span>\n          <p class=\"note\">分别对应基础版、旗舰版、团队版的同时在线上限。</p>\n        </div>\n\n        <div class=\"cell c-span-4\">\n          <span class=\"label\">最高月流量额度</span>\n          <span class=\"value\">1000GB</span>\n          <p class=\"note\">团队版每月额度，旗舰版 300GB，基础版 100GB。</p>\n        </div>\n\n        <div class=\"cell c-span-4\">\n          <span class=\"label\">支持方式</span>\n          <ul class=\"mini\">\n            <li><span>基础版</span><b>常规支持</b></li>\n            <li><span>旗舰版</span><b>优先工单</b></li>\n            <li><span>团队版</span><b>专属客户经理</b></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-title\">\n        <span class=\"no\">01</span>\n        <h2>三档订阅，逐级递进</h2>\n      </div>\n      <p class=\"sec-lede\">从基础版往上走，每一档加的是额度、设备数与支持力度。先看自己每月大概用多少流量、几台设备同时在线，再对照阶梯。</p>\n\n      <div class=\"stairs\">\n\n        <article class=\"step step-1\">\n          <span class=\"idx\">01</span>\n          <div>\n            <h3 class=\"plan-name\">基础版</h3>\n            <p class=\"price\">¥15 / 月</p>\n            <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          </div>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"step step-2 featured\">\n          <span class=\"idx\">02</span>\n          <div>\n            <span class=\"badge\">推荐档</span>\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <p class=\"price\">¥35 / 月</p>\n            <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          </div>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"step step-3\">\n          <span class=\"idx\">03</span>\n          <div>\n            <h3 class=\"plan-name\">团队版</h3>\n            <p class=\"price\">¥85 / 月</p>\n            <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-title\">\n        <span class=\"no\">02</span>\n        <h2>从下单到用上，按这五步走</h2>\n      </div>\n      <p class=\"sec-lede\">下面的步骤是顺序清单，不是推荐理由。每一步做完再进下一步，出问题的时候也能快速定位到哪一环。</p>\n\n      <div class=\"duo\">\n        <div class=\"ticket\">\n          <h3>使用步骤</h3>\n          <ol>\n            <li>先量一下自己的用量：每月大概多少 GB、几台设备要同时在线，按这两个数选档位，不要先看价格。</li>\n            <li>确认付费周期。月付按整月计，年付按十个月计；中途想换档，按新周期重新选择即可。</li>\n            <li>拿到订阅信息后，在对应设备上安装客户端，把配置导入进去。客户端只从你信任的渠道获取。</li>\n            <li>连接后在设备上打开一个常用网页，确认能正常打开，再去看需要解锁的内容是否可访问。</li>\n            <li>把配置信息存在自己手里，不要转发到公开群组；设备数量是按同时在线算的，轮换使用前先断开旧设备。</li>\n          </ol>\n        </div>\n\n        <div class=\"ticket\">\n          <h3>选档前，先回答三个问题</h3>\n          <p><b>一个月看多少？</b>碎片化使用、主要看文字和短视频，100GB 通常能撑住；常看高清长片或整天挂着，从 300GB 起更稳。</p>\n          <p><b>几台设备一起开？</b>手机加电脑是最常见的两台，再加平板就到了三台。超过三台，基础版就不够用。</p>\n          <p><b>要的是速度还是省心？</b>旗舰版多了专线优化和优先工单，团队版多了定制路由和客户经理。先判断自己是\"偶尔卡一下忍得了\"还是\"卡了就要找人\"。</p>\n          <ul>\n            <li><span>流量用超</span><b>升级档位</b></li>\n            <li><span>设备数不够</span><b>升级档位</b></li>\n            <li><span>只是想试试</span><b>从基础版起</b></li>\n            <li><span>多人共用</span><b>团队版</b></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-title\">\n        <span class=\"no\">03</span>\n        <h2>客户端与配置说明</h2>\n      </div>\n      <p class=\"sec-lede\">客户端按设备类型分。下面只说明各平台该装什么、配置从哪进，不提供下载地址；具体安装包请以你获取订阅时的渠道说明为准。</p>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <h3>桌面端（Windows / macOS）</h3>\n          <p>在桌面系统上装通用客户端，把订阅配置导入后即可切换线路。首次连接建议先测一下本地网络是否正常。</p>\n          <span class=\"state\">导入方式以客户端内提示为准</span>\n        </div>\n        <div class=\"client\">\n          <h3>移动端（iOS / Android）</h3>\n          <p>手机端通常通过应用商店或对应渠道获取客户端，再导入同一份配置。设备数按同时在线计算，用完可手动断开。</p>\n          <span class=\"state\">安装来源请自行核实</span>\n        </div>\n        <div class=\"client\">\n          <h3>路由器与多设备</h3>\n          <p>需要让家里或办公室的多台设备共用时，可在支持的路由器上做统一配置。团队版的定制路由适合有固定网络结构的情况。</p>\n          <span class=\"state\">需要一定网络基础</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-title\">\n        <span class=\"no\">04</span>\n        <h2>常见问题，按主题分组</h2>\n      </div>\n      <p class=\"sec-lede\">问题按\"选档、付费、使用、支持\"四类归在一起，先找到自己关心的那组。</p>\n\n      <div class=\"faq-groups\">\n\n        <div class=\"faq-group\">\n          <h3>关于选档</h3>\n          <div class=\"qa-grid\">\n            <div class=\"qa\">\n              <h4>基础版和旗舰版差在哪？</h4>\n              <p>流量从每月 100GB 提到 300GB，同时在线设备从 3 台提到 5 台；此外旗舰版增加了全节点原生流媒体解锁、IPLC 专线游戏加速优化和 7x24 优先工单。差价主要在额度与支持力度上。</p>\n            </div>\n            <div class=\"qa\">\n              <h4>团队版适合几个人用？</h4>\n              <p>团队版按 20 台设备同时在线、每月 1000GB 的额度设计，适合多人共用或设备数量较多的小团队。如果只是个人多设备，旗舰版通常够用。</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于付费</h3>\n          <div class=\"qa-grid\">\n            <div class=\"qa\">\n              <h4>年付怎么算？</h4>\n              <p>三档年付都按月付价的十个月计：基础版 ¥150、旗舰版 ¥350、团队版 ¥850。月付则按整月价格 ¥15 / ¥35 / ¥85 计算。</p>\n            </div>\n            <div class=\"qa\">\n              <h4>中途能换档吗？</h4>\n              <p>可以按新周期重新选择档位。具体是升级补差还是到期切换，取决于你下单时渠道给出的规则，请以当时的说明为准。</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于使用</h3>\n          <div class=\"qa-grid\">\n            <div class=\"qa\">\n              <h4>流量用超了会怎样？</h4>\n              <p>每档都写明每月额度，额度用完后当月无法继续按原档使用。最直接的处理方式是下个周期选更高一档，避免每月都卡在同一处。</p>\n            </div>\n            <div class=\"qa\">\n              <h4>设备数量怎么算的？</h4>\n              <p>按同时在线计算，不是按累计登录过的设备算。旧设备不断开就仍占一个位置，切换设备时先断开再连新的。</p>\n            </div>\n            <div class=\"qa\">\n              <h4>配置信息能分享给别人吗？</h4>\n              <p>不建议。配置与你的订阅绑定，分享出去等于把额度让给别人用，也会让设备数被占用。放在自己可控的设备上即可。</p>\n            </div>\n            <div class=\"qa\">\n              <h4>第一次连接要注意什么？</h4>\n              <p>先确认本地网络本身可用，再导入配置连接；连上后打开一个常用网页验证，再访问自己真正需要的内容。如果网页打不开，先排除本地网络问题。</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于支持</h3>\n          <div class=\"qa-grid\">\n            <div class=\"qa\">\n              <h4>遇到问题找谁？</h4>\n              <p>旗舰版提供 7x24 优先工单支持，团队版另有专属客户经理；基础版走常规支持渠道。提问时把设备系统、客户端类型和出问题的具体现象写清楚，能少一轮来回。</p>\n            </div>\n            <div class=\"qa\">\n              <h4>页面上没写的功能，是不是就没有？</h4>\n              <p>这份页面只列出三档方案里明确写到的权益，未提及的部分不作承诺。购买前如有疑问，先向提供订阅的渠道确认。</p>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <div class=\"tail\">\n    <div class=\"wrap\">\n      <nav class=\"jumps\" aria-label=\"页尾跳转\">\n        <a href=\"#plans\">回到价格与权益</a>\n        <a href=\"#guide\">回到使用步骤</a>\n        <a href=\"#clients\">回到客户端说明</a>\n        <a href=\"#top\">回到顶部</a>\n      </nav>\n      <div class=\"meta\">\n        <span>猪云 · 订阅方案与使用说明</span>\n        <span>价格与权益以本页所列内容为准</span>\n      </div>\n    </div>\n  </div>\n\n</main>",
